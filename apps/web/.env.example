# ─────────────────────────────────────────────────────────────
# Prince Net Web App — Environment Example
# انسخ هذا الملف إلى .env وعدّل القيم
# لا تضع أي قيمة حقيقية في هذا الملف
# ─────────────────────────────────────────────────────────────

# API base URL — نسبي ليعمل عبر Vite proxy (محلي) أو Vercel rewrites (إنتاج)
# محلي: VITE_API_BASE_URL="/api/v1"
# Vercel: VITE_API_BASE_URL="/api/v1"
VITE_API_BASE_URL="/api/v1"

# اسم التطبيق (يُستخدم في الواجهة والعنوان)
VITE_APP_NAME="Prince Net"
