{
  "name": "prince-net",
  "version": "1.0.0",
  "private": true,
  "description": "Prince Net Management System",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.28.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:packages": "turbo build --filter=\"./packages/*\"",
    "build:apps": "turbo build --filter=\"./apps/*\"",
    "start": "turbo start:prod --filter=@prince-net/api",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "prisma:generate": "turbo prisma:generate --filter=@prince-net/api",
    "prisma:migrate": "turbo prisma:migrate --filter=@prince-net/api",
    "prisma:deploy": "turbo prisma:deploy --filter=@prince-net/api",
    "prisma:seed": "turbo prisma:seed --filter=@prince-net/api",
    "prisma:studio": "turbo prisma:studio --filter=@prince-net/api",
    "clean": "rimraf node_modules apps/api/node_modules apps/web/node_modules packages/*/node_modules apps/api/dist apps/web/dist packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
