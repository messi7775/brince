# ─────────────────────────────────────────────────────────────
# Prince Net Management System — Environment Example
# انسخ هذا الملف إلى .env وعدّل القيم
# لا تضع أي قيمة حقيقية في هذا الملف
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
# Local PostgreSQL:
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/prince_net?schema=public"
#
# Neon (serverless PostgreSQL — استخدم الـ pooled connection string):
# DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/prince_net?schema=public&sslmode=require"
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/prince_net?schema=public"

# JWT (يُستخدم داخل HttpOnly Cookie)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"
JWT_COOKIE_NAME="prince_net_token"

# Cookies / Security
# في الإنتاج (NODE_ENV=production) تكون الكوكيز آمنة تلقائيًا (secure=true)
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
CSRF_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"
CSRF_COOKIE_NAME="prince_net_csrf"

# CORS
# فارغ = يعكس أي origin (مناسب لـ Vercel حيث API و Web على نفس النطاق)
# محلي: CORS_ORIGIN="http://localhost:5173"
CORS_ORIGIN=""

# Admin (يُستخدم فقط في Seed)
ADMIN_EMAIL="admin@prince-net.local"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS"

# App
APP_NAME=Prince Net
APP_CURRENCY=ريال
APP_CURRENCY_SYMBOL=ر.ي

# Backups
# ⚠️ يجب أن يكون مسارًا مطلقًا، خارج أي web root / public directory.
# Vercel: استخدم /tmp (نظام ملفات مؤقت)
# Serv00:  BACKUP_DIR="/var/prince-net/backups"
BACKUP_DIR="/tmp"

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Web (Vite)
# نسبي ليعمل عبر Vercel rewrites (نفس النطاق)
# محلي: VITE_API_BASE_URL="http://localhost:3000/api/v1"
VITE_API_BASE_URL="/api/v1"
VITE_APP_NAME=Prince Net
