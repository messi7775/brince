# ─────────────────────────────────────────────────────────────
# Prince Net Management System — Environment Example
# انسخ هذا الملف إلى .env وعدّل القيم
# لا تضع أي قيمة حقيقية في هذا الملف
# ─────────────────────────────────────────────────────────────

# ─── Vercel Required (أضفها في Vercel Dashboard → Settings → Environment Variables) ───
# هذه المتغيرات يجب تعيينها على Vercel ليعمل التطبيق

# Database — Neon (serverless PostgreSQL)
# استخدم الـ pooled connection string مع sslmode=require:
# DATABASE_URL="postgresql://***@ep-xxx-pooler.REGION.aws.neon.tech/prince_net?schema=public&sslmode=require"
DATABASE_URL="postgresql://***@localhost:5432/prince_net?schema=public"

# JWT (يُستخدم داخل HttpOnly Cookie)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"

# CSRF (double-submit cookie pattern)
CSRF_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_16_CHARS"

# ─── Vercel Optional (لها قيم افتراضية في env.validation.ts) ───
# لا تحتاج لتعيينها على Vercel إلا إذا أردت تغيير القيم الافتراضية

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT extras
JWT_EXPIRES_IN="7d"
JWT_COOKIE_NAME="prince_net_token"

# Cookies / Security
# في الإنتاج (NODE_ENV=production) تكون الكوكيز آمنة تلقائيًا (secure=true)
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
CSRF_COOKIE_NAME="prince_net_csrf"

# CORS
# فارغ = يعكس أي origin (مناسب لـ Vercel حيث API و Web على نفس النطاق)
# محلي: CORS_ORIGIN="http://localhost:5173"
CORS_ORIGIN=""

# Backups
# ⚠️ يجب أن يكون مسارًا مطلقًا، خارج أي web root / public directory.
# Vercel: استخدم /tmp (نظام ملفات مؤقت)
BACKUP_DIR="/tmp"

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ─── Seed Only (مطلوبة فقط لتشغيل prisma:seed، وليست مطلوبة لتشغيل التطبيق) ───
ADMIN_EMAIL="admin@prince-net.local"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS"

# ─── Web (Vite — متغيرات وقت البناء) ───
# نسبي ليعمل عبر Vercel rewrites (نفس النطاق)
VITE_API_BASE_URL="/api/v1"
VITE_APP_NAME=Prince Net

# ─── App (تُستخدم في الـ API) ───
APP_NAME=Prince Net
APP_CURRENCY=ريال
APP_CURRENCY_SYMBOL=ر.ي
