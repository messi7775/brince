# Base44 development defaults — placeholders only.
# Real secrets (JWT_SECRET, CSRF_SECRET, ADMIN_PASSWORD) come from /run/base44/app.env
# which is listed AFTER this file in compose env_file, so it always wins.

# Runtime
NODE_ENV=development
API_PREFIX=api/v1

# JWT
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=prince_net_token

# Cookies / Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=prince_net_csrf

# CORS (overridden by compose environment for single-origin wiring)
CORS_ORIGIN=http://localhost:3000

# Admin (email only — password comes from app.env secret)
ADMIN_EMAIL=admin@prince-net.local

# App
APP_NAME=Prince Net
APP_CURRENCY=ريال
APP_CURRENCY_SYMBOL=ر.ي

# Backups (absolute path — mounted as a compose volume)
BACKUP_DIR=/tmp/prince-net-backups

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Web (Vite)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Prince Net
